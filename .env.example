# Airtable — waitlist storage (CRM-ready)
# Create a Personal Access Token at https://airtable.com/create/tokens
# with data.records:read + data.records:write scopes on the chosen base.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Waitlist

# Supabase — waitlist mirror + atomic counter
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — $1 skip-the-line payment
# Test keys for local dev. Use restricted live keys in production.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Resend — transactional email
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=MyParentalControls <hello@myparentalcontrols.com>

# Site URL — used for Stripe success/cancel URLs and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics — GA4 Measurement ID, usually starts with G-
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Premium-queue display offset. First paid user shows as #8.
# (Waitlist counter is now a Postgres sequence — see
# scripts/supabase-waitlist-counter.sql — so no waitlist offset env var.)
PREMIUM_BASE_OFFSET=7
